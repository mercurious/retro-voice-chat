diff --git a/src/backend.h b/src/backend.h
index 534a126..322f36a 100644
--- a/src/backend.h
+++ b/src/backend.h
@@ -18,6 +18,13 @@
 // One thread per physical core (logical / 2 for HT/SMT): GEMM shares the
 // SIMD units across hyperthreads.
 static int backend_cpu_n_threads(void) {
+    // PT_THREADS overrides (hardware_concurrency ignores taskset pinning)
+    if (const char * e = std::getenv("PT_THREADS")) {
+        const int t = std::atoi(e);
+        if (t > 0) {
+            return t;
+        }
+    }
     int n = (int) std::thread::hardware_concurrency() / 2;
     return n > 0 ? n : 1;
 }
